# ============================================================
# VAR VPN — نمونه متغیرهای محیطی
# ⛔ این فایل را با مقادیر واقعی هرگز git commit نکنید.
#    روی سرور:  cp .env.example .env  و سپس مقادیر را پر کنید.
# ============================================================

# ---------- Telegram ----------
# از @BotFather → /newbot (فرمت: 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# چت/کانال اطلاع‌رسانی سفارش‌ها به مدیر (اختیاری)
TELEGRAM_ADMIN_CHAT_ID=

# ---------- دیتابیس کسب‌وکار VAR (جدا از radius) ----------
VAR_DB_HOST=host.docker.internal
VAR_DB_PORT=3306
VAR_DB_NAME=var_business
VAR_DB_USER=var_app
VAR_DB_PASSWORD=

# ---------- دیتابیس radius — فقط کاربر خواندنی (SELECT) ----------
# ساخت این کاربر نیازمند بکاپ قبلی و تأیید است (docs/DEPLOY.md)
RADIUS_DB_HOST=host.docker.internal
RADIUS_DB_PORT=3306
RADIUS_DB_NAME=radius
RADIUS_DB_USER=var_ro
RADIUS_DB_PASSWORD=

# secret مشترک FreeRADIUS/NAS — فقط سمت سرور، هرگز لاگ نشود
RADIUS_NAS_SECRET=

# ---------- درگاه پرداخت (فاز بعد — فعلاً کارت‌به‌کارت) ----------
GATEWAY_PROVIDER=zarinpal
GATEWAY_MERCHANT_ID=
GATEWAY_API_KEY=
GATEWAY_CALLBACK_URL=https://app.YOURDOMAIN.com/api/payments/callback

# ---------- اپ ----------
APP_PUBLIC_URL=https://app.YOURDOMAIN.com
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO
