# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=9000
FASTAPI_ENV=production

# Database (PostgreSQL - varvpn)
DATABASE_URL=postgresql://varvpn_user:varvpn_pass@127.0.0.1:5433/varvpn

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL (cPanel domain)
FRONTEND_URL=https://varminiapp.popserver.shop

# Security
SECRET_KEY=your_secret_key_for_jwt_or_sessions
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
